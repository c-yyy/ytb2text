{
  "name": "ytb2text",
  "version": "0.2.2",
  "private": true,
  "description": "视频转文字助手 —— 浏览器本地跑 Whisper 的 Chrome MV3 插件，音频不出本机、0 API 成本",
  "scripts": {
    "vendor": "node tools/vendor.js",
    "check": "node tools/selfcheck.js",
    "smoke": "node tools/smoke.js",
    "smoke:full": "node tools/smoke.js --with-inference",
    "yt": "node tools/youtube-check.js",
    "verify": "node tools/selfcheck.js && node tools/smoke.js",
    "verify:all": "node tools/selfcheck.js && node tools/smoke.js && node tools/youtube-check.js",
    "pack": "bash tools/pack.sh",
    "zip": "bash tools/zip.sh"
  },
  "devDependencies": {
    "@huggingface/transformers": "3.7.5",
    "crx3": "^1.1.3"
  }
}
